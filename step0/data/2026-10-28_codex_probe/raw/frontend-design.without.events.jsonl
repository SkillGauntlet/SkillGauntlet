ia(max-width:390px){.nav-links{gap:8px}.nav-links a:last-child{display:none}.nav-action{padding:9px;font-size:8px}.hero{height:700px}.hero-art{height:43%}.product-image{height:300px}.footer-links{gap:10px;font-size:8px}}\n    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*:before,*:after{transition:none\"'!important}}\n  </style>\n</head>\n<body>\n  <div class=\"announcement\">FREE SHIPPING ON 2+ BAGS <span>✳</span> ROASTED FRESH, SHIPPED TUESDAY</div>\n  <nav class=\"nav\" aria-label=\"Main navigation\">\n    <div class=\"nav-links\"><a href=\"#coffee\">Coffee</a><a href=\"#story\">Our way</a><a href=\"#visit\">Find us</a></div>\n    <a class=\"wordmark\" href=\"#top\" aria-label=\"Moss and Ember home\">moss & ember<small>PORTLAND, OREGON</small></a>\n    <a class=\"nav-action\" href=\"#coffee\">SHOP THE ROAST <span aria-hidden=\"true\">↗</span></a>\n  </nav>\n  <main id=\"top\">\n    <section class=\"hero\" aria-labelledby=\"hero-title\">\n      <div class=\"hero-copy\"><div class=\"eyebrow\">A little more morning</div><h1 id=\"hero-title\">Good things<br />take <em>their time.</em></h1><p class=\"hero-desc\">Patiently roasted, never rushed. Coffee for slow starts, long walks, and the bits in between.</p><a class=\"pill-link\" href=\"#coffee\">MEET YOUR NEW EVERYDAY <i aria-hidden=\"true\">↗</i></a></div>\n      <div class=\"hero-art\" aria-hidden=\"true\"><div class=\"sun\"></div><div class=\"orbit\"></div><div class=\"bean\"></div><div class=\"art-note\">39° 42′ N — ROASTED IN PORTLAND</div></div>\n      <div class=\"hero-stamp\" aria-hidden=\"true\">SMALL<br />BATCH<br />✳<br />PDX</div>\n    </section>\n    <div class=\"tickbar\" aria-hidden=\"true\"><span>ROASTED WITH INTENTION</span><b>✳</b><span>GROWN WITH CARE</span><b>✳</b><span>SHARED SLOWLY</span><b>✳</b><span>ROASTED WITH INTENTION</span><b>✳</b><span>GROWN WITH CARE</span></div>\n    <section class=\"intro\" id=\"story\"><div class=\"label\">01 — A note from the roastery</div><p class=\"intro-copy\">Coffee doesn'\"'t need to be complicated. It just needs a good beginning, <em>a little patience,</em> and someone to share it with.</p><p class=\\\"intro-aside\\\">We’re a two-person roastery tucked between the evergreens and the rainy side of town. We buy coffees we believe in, roast them in small batches, and send them your way at their best.</p></section>\n    <section class=\\\"featured\\\" id=\\\"coffee\\\"><div class=\\\"section-top\\\"><div><div class=\\\"label\\\">02 — The current rotation</div><h2>Three good places to start.</h2></div><a class=\\\"text-link\\\" href=\\\"#newsletter\\\">FIND YOUR CUP ↗</a></div><div class=\\\"products\\\">\n      <article class=\\\"product\\\"><a href=\\\"#newsletter\\\" aria-label=\\\"Shop Daybreak coffee\\\"><div class=\\\"product-image\\\"><div class=\\\"orbit\\\"></div><div class=\\\"bag\\\"></div></div><div class=\\\"product-info\\\"><div>01 / Daybreak <small>GUATEMALA · HONEY · ALMOND</small></div><span class=\\\"price\\\">\"'$19 / 250G</span></div><p class=\"product-note\">Easy company for early hours.</p></a></article>\n      <article class=\"product\"><a href=\"#newsletter\" aria-label=\"Shop Soft Focus coffee\"><div class=\"product-image\"><div class=\"orbit\"></div><div class=\"bag\"></div></div><div class=\"product-info\"><div>02 / Soft Focus <small>COLOMBIA · PLUM · COCOA</small></div><span class=\"price\">$21 / 250G</span></div><p class=\"product-note\">A little rounder, a little later.</p></a></article>\n      <article class=\"product\"><a href=\"#newsletter\" aria-label=\"Shop Long Weekend coffee\"><div class=\"product-image\"><div class=\"orbit\"></div><div class=\"bag\"></div></div><div class=\"product-info\"><div>03 / Long Weekend <small>ETHIOPIA · CITRUS · JASMINE</small></div><span class=\"price\">$22 / 250G</span></div><p class=\"product-note\">For when there’s nowhere to be.</p></a></article>\n    </div></section>\n    <section class=\"manifesto\"><div class=\"label\">03 — How we see it</div><blockquote>Less hurry.<br />More <em>really good</em> coffee.</blockquote><p>ROASTED IN SMALL BATCHES · PORTLAND, OR · ALWAYS FRESH</p><div class=\"manifesto-shape\" aria-hidden=\"true\"></div></section>\n    <section class=\"visit\" id=\"visit\"><div class=\"visit-art\" aria-hidden=\"true\"><div class=\"window\"></div></div><div class=\"visit-copy\"><div class=\"label\">04 — Come by sometime</div><h2>Meet us<br />where the<br /><em>good smell</em> is.</h2><p>Our little roastery window is open to neighbors, curious drinkers, and anyone who could use a warm cup. We’ll put the kettle on.</p><div class=\"visit-data\"><div><strong>Find the door</strong>SE PORTLAND, OR</div><div><strong>Roastery hours</strong>THU—SAT · 8—2</div></div><a class=\"pill-link\" href=\"https://maps.google.com/?q=Portland%2C+Oregon\" target=\"_blank\" rel=\"noreferrer\">GET DIRECTIONS <i aria-hidden=\"true\">↗</i></a></div></section>\n    <section class=\"newsletter\" id=\"newsletter\"><div><div class=\"label\">A good thing, occasionally</div><h2>A little note<br />from the roastery.</h2></div><div><p>New coffees, small happenings, and the odd very good recipe. A short email when we have something worth sharing.</p><form class=\"signup\" id=\"signup\"><label for=\"email\" class=\"sr-only\" style=\"position:absolute;clip:rect(0,0,0,0);clip-path:inset(50%);width:1px;height:1px;overflow:hidden\">Your email address</label><input id=\"email\" type=\"email\" placeholder=\"YOUR EMAIL ADDRESS\" required /><button type=\"submit\">COUNT ME IN ↗</button></form><div class=\"form-message\" id=\"form-message\" role=\"status\" aria-live=\"polite\"></div></div></section>\n  </main>\n  <footer class=\"footer\"><a class=\"footer-mark\" href=\"#top\">moss & ember</a><div class=\"footer-links\"><a href=\"#coffee\">Coffee</a><a href=\"#story\">Our way</a><a href=\"#visit\">Visit</a><a href=\"mailto:hello@mossandember.coffee\">Say hello</a></div><span>ROASTED SLOW IN PORTLAND, OR · © 2025</span></footer>\n